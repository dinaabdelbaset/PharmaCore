# Visual Studio / .NET Core / .NET standard GitIgnore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/ActiveWriter)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Log]/

# Visual Studio 2015/2017/2019/2022 cache's and settings
.vs/
# Generated user files
*.slnLaunch.user

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
packages/

# Built output / publish directories
[Pp]ublish/
[Pp]ublish_API/
[Pp]ublish_*/
*.zip
*.rar
*.tar.gz
*.7z

# Log files
*.log
error.log

# Local/Development appsettings secrets & environment files
# appsettings.Development.json
# appsettings.Local.json
.env
.env*.local
.env.local

# Node/NPM dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js/React build outputs
.next/
out/
dist/
.cache/
